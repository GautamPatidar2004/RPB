# Application Environment
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Configuration
# Option 1: Direct Connection URL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railway_block_planning

# Option 2: Parameterized Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=railway_block_planning
PGMAX_CONNECTIONS=20
